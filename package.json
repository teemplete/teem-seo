{
  "name": "teem-seo",
  "version": "0.6.1",
  "description": "Yoast-like SEO and readability analysis for React and Next.js — English & Persian",
  "keywords": [
    "seo",
    "yoast",
    "readability",
    "react",
    "nextjs",
    "persian",
    "farsi",
    "content-analysis",
    "meta",
    "serp"
  ],
  "homepage": "https://github.com/teemplete/teem-seo#readme",
  "bugs": {
    "url": "https://github.com/teemplete/teem-seo/issues"
  },
  "license": "MIT",
  "author": "Erfan (https://github.com/erfanatp)",
  "contributors": [
    "Erfan (https://github.com/erfanatp)",
    "Sepehr Pourjozi (https://github.com/133pr)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teemplete/teem-seo.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "require": "./dist/next/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-styles.mjs && node scripts/add-use-client.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
